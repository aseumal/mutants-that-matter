# Any OpenAI-compatible endpoint works: Groq, OpenRouter, Together, a local vLLM or Ollama server.
# Copy to .env and fill in. Never commit .env.

MTM_BASE_URL=https://api.groq.com/openai/v1
MTM_API_KEY=replace-me

# Model that plays the agent (follows the rule, receives the probe)
MTM_AGENT_MODEL=llama-3.3-70b-versatile

# Model that writes the compaction summary (often the same model, as in self-summarization)
MTM_COMPACTOR_MODEL=llama-3.3-70b-versatile

# Optional: seconds to wait between calls if your provider rate-limits
MTM_REQUEST_DELAY=0
